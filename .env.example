# Copy to .env for local dev, or set these in Railway's environment variables for prod.

# --- Database ---
# Railway provides this automatically when you attach a PostgreSQL plugin.
# For local dev: postgresql://user:pass@localhost:5432/saha
DATABASE_URL=

# --- Auth ---
# 32+ character random string. Generate with: openssl rand -hex 48
JWT_SECRET=

# Initial admin account. ADMIN_PASSWORD is only read at boot — used to seed or rotate
# the hashed password in the users table. You can remove it from Railway after the
# admin is seeded; it does not need to remain set in production.
ADMIN_EMAIL=sahaforlearning1675@gmail.com
ADMIN_PASSWORD=

# --- Email (Resend) ---
RESEND_API_KEY=
CONTACT_EMAIL=sahaforlearning1675@gmail.com

# --- Misc ---
# Used in admin-notification email links so the "Open Admin Dashboard" button
# points at the right host. Defaults to https://sahainstituteforlearning.com.
SITE_ORIGIN=https://sahainstituteforlearning.com

# Port — Railway sets this automatically. Don't set in production.
PORT=3000
